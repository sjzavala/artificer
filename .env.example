# ---------------------------------------------------------------------------
# Artificer — environment variables
# Copy to `.env.local` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED — Anthropic API key. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the extraction / drafting model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Access gate (demo lock — NOT enterprise auth)
# ---------------------------------------------------------------------------

# Shared access code stakeholders type on the gate page.
ARTIFICER_ACCESS_CODE=changeme

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARTIFICER_SESSION_SECRET=generate-a-long-random-value

# ---------------------------------------------------------------------------
# Storage adapter
# Local dev  -> LocalFileStore (JSON under /data) when BLOB_READ_WRITE_TOKEN is unset.
# Production -> BlobStore (Vercel Blob) when BLOB_READ_WRITE_TOKEN is present.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Force a store implementation regardless of the above ("local" | "blob").
# ARTIFICER_STORE=local

# ---------------------------------------------------------------------------
# Salesforce adapter
# Mock mode is the default. Setting SF_LOGIN_URL + SF_USERNAME + SF_PASSWORD
# activates the real jsforce adapter. See docs/salesforce-schema.md.
# ---------------------------------------------------------------------------
# SF_LOGIN_URL=https://login.salesforce.com
# SF_USERNAME=you@example.com
# SF_PASSWORD=password+securitytoken
# SF_INSTANCE_URL=https://your-domain.my.salesforce.com
